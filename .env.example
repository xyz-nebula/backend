# Auth configuration
# JWT_SECRET_KEY=change-me
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=30

# Valkey configuration
# VALKEY_HOST=localhost
# VALKEY_PORT=6379
# VALKEY_DB=0

# FastAPI configuration
# PORT=3000
# ROOT_PATH=/

# Database configuration
# defaults to sqlite://db.sqlite3; uncomment to use Postgres locally
# DB_URL=

# ADMIN_CODE=change-me

# Activation code settings
# ACTIVATION_CODE_EXPIRE_MINUTES=60
# ACTIVATION_LINK_BASE_URL=http://example.com/activate?code={code}

# Mailer configuration
# "log" (default, logs the activation link instead of sending it) or "smtp"
# MAILER_TYPE=log
# required when MAILER_TYPE=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=change-me
# SMTP_PASSWORD=change-me
# SMTP_FROM=no-reply@nebula.local
# "starttls" (default, e.g. port 587), "tls" (implicit TLS/SMTPS, e.g. port 465),
# or "none" (plaintext)
# SMTP_TLS_MODE=starttls
